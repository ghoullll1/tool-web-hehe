# Copy this file to deploy/.env and replace every blank required value.
# Do not commit deploy/.env.

COMPOSE_PROJECT_NAME=tool-web
TZ=Asia/Shanghai

# Public entry point. Use an HTTPS origin when a reverse proxy terminates TLS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088

# Container images. Pin RustFS to a tested release or digest for production.
MYSQL_IMAGE=mysql:8.4
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_CONSOLE_PORT=9001

# MySQL. Generate unique values; do not reuse the root password.
MYSQL_DATABASE=tool_web
MYSQL_USER=tool_web
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Protected backend administration API.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# RustFS administrator credentials. Access keys should use A-Z and 0-9 only.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Tool Web object-storage credentials. For a quick private deployment these may
# initially match the RustFS credentials. Production should use a bucket-scoped
# RustFS service account instead of the RustFS administrator account.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=temp-files
OBJECT_STORAGE_BASE_PREFIX=tool-web/

# Shared internal token between the Java backend and MarkItDown worker.
# It must contain at least 32 characters.
DOCUMENT_CONVERSION_WORKER_TOKEN=
DOCUMENT_CONVERSION_MAX_CONCURRENT=4
MARKITDOWN_WORKER_MAX_UPLOAD_BYTES=10485760
MARKITDOWN_WORKER_MAX_OUTPUT_CHARACTERS=16777216
MARKITDOWN_WORKER_MAX_CONCURRENT_CONVERSIONS=2
MARKITDOWN_WORKER_QUEUE_TIMEOUT_SECONDS=5
MARKITDOWN_WORKER_CONVERSION_TIMEOUT_SECONDS=120
MARKITDOWN_WORKER_ALLOWED_EXTENSIONS=pdf,docx,pptx,xlsx,xls,html,htm,csv,json,xml,txt,md,rtf,eml,msg

# Application limits.
TEMPORARY_FILE_SHARE_MAX_FILE_SIZE=30MB
TEMPORARY_FILE_SHARE_MAX_REQUEST_SIZE=31MB
TEMPORARY_FILE_SHARE_MAX_STORED_BYTES=1GB
HTTP_DIAGNOSTICS_ALLOWED_PORTS=80,443
